# ApproveFlow backend development
PORT=8000
DB_HOST=localhost
DB_PORT=5433
DB_NAME=approveflow
DB_USER=approveflow
DB_PASSWORD=change_me
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h
CORS_ALLOWED_ORIGINS=http://localhost:5173
# For hosted PostgreSQL, prefer DATABASE_URL. Enable TLS only when required.
# DATABASE_URL=postgresql://user:password@host:5432/approveflow
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true
# Hosted operations only: exact URL-path database identity plus one-time confirmation.
# HOSTED_DATABASE_NAME=approveflow_render
# CONFIRM_HOSTED_MIGRATION=false
# CONFIRM_HOSTED_DEMO_PROVISION=false
# HOSTED_SARAH_PASSWORD=runtime-secret-only
# HOSTED_MARK_PASSWORD=runtime-secret-only
